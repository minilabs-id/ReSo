{
  "name": "reso",
  "description": "ReSo — Rekap Engagement Sosmed (aplikasi desktop offline)",
  "author": "Diskominfo",
  "private": true,
  "version": "1.0.86",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "electron-vite dev",
    "build": "npm run lint && npm run typecheck:desktop && vite build",
    "build:desktop": "electron-vite build",
    "start:desktop": "electron-vite preview",
    "rebuild:native": "node scripts/rebuild-native.cjs",
    "dist:win": "npm run rebuild:native && npm run build:desktop && electron-builder --win nsis",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck:desktop": "tsc --noEmit -p electron/tsconfig.json",
    "test:matching": "tsx src/lib/matching.test.ts",
    "test:stress": "tsx src/lib/extreme-stress.test.ts",
    "test:shared": "tsx src/shared/index.test.ts && tsx src/shared/run-state.test.ts && tsx electron/store/settings-schema.test.ts && tsx electron/store/state-schema.test.ts && tsx electron/scrape/engine-tiktok-logic.test.ts && tsx electron/scrape/engine-social.test.ts && tsx electron/scrape/engine.test.ts && tsx electron/db/schema.test.ts",
    "test:local-db": "tsx src/lib/local-db.test.ts",
    "test:date": "tsx src/lib/date.test.ts",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','out','release'])fs.rmSync(d,{recursive:true,force:true})\"",
    "test": "npm run test:shared && npm run test:local-db && npm run test:matching && npm run test:date && npm run test:stress"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "better-sqlite3": "11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^10.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "modern-screenshot": "^4.6.8",
    "motion": "^12.23.24",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "sharp": "^0.35.3",
    "shadcn": "^4.2.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
